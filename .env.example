# ============================================
# 应用配置
# ============================================
APP_PORT=3001

# ============================================
# LLM 配置
# ============================================
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-apikey
LLM_MODEL=deepseek-flash
# 思考字段下发方式（需求域 C）：控制请求体携带哪些思考相关字段。
#   none     = 均不下发（默认；接入非 DeepSeek 的 OpenAI 兼容服务商不会被未知字段拒绝）
#   effort   = 仅下发推理强度
#   thinking = 仅下发思考开关
#   both     = 两者都下发
#   是否下发只看这一项；下面两项只提供「取值」，不再各自决定请求体是否携带字段。
LLM_THINKING_MODE=none
# 思考开关字段的取值来源（true=开启，false=关闭）；不下发时该值不进入请求体。
LLM_THINKING=true
# 推理强度字段的取值来源（low / high / max）；不下发时该值不进入请求体。
LLM_REASONING_EFFORT=high

# ============================================
# 文件工具配置（US-CFG-1）
# ============================================
# 总操作目录：AI 文件操作的唯一沙箱根，与 data 目录平级。
#   默认 working，即 <项目根>/working；所有文件操作限定在此目录内，越界拒绝。
FILE_ROOT_DIR=working
# 读开关：控制「列出目录/读取文件/查看信息/搜索文件路径/搜索文件内容」。
#   默认开启（读操作无副作用）。
FILE_READ_ENABLED=true
# 新建开关：控制「创建文件夹/创建新文件/追加内容」。
#   默认关闭（写操作需显式开启）。
FILE_CREATE_ENABLED=false
# 修改开关：控制「整篇覆盖/定点替换/移动重命名/删除」。
#   默认关闭（含删除，破坏性最强，请谨慎开启）。
FILE_MODIFY_ENABLED=false
# 区间读取默认行数（批次一 / FR-38）：read_file 只给 startLine 时使用的行数，默认 2000。
#   有效范围 1–50000；写 0、负数、非整数会回退默认值 2000 并在启动日志告警（不会静默吞掉）。
#   实际每次返回的行数还受「单次结果字符上限」约束，以返回的 lastLineNum 为准。
#   本项不进配置页（与 BROWSER_MAX_SESSIONS 同口径，手工维护）；保存 .env 后热更即生效。
FILE_READ_DEFAULT_LINES=2000

# ============================================
# LLM 对话日志配置（Sprint 5.1 / US-LOG-1）
# ============================================
# 日志总开关：true=记录与 LLM 的对话日志（供问题分析），false/留空=关闭。
#   默认关闭，避免日常使用产生额外 IO 与磁盘占用。
LLM_LOG_ENABLED=false
# 日志文件路径（JSONL，每行一条 JSON；内容不截断）。
LLM_LOG_FILE=data/llm_logs.jsonl
# 日志条数上限：超出后自动清理最旧记录，防止无限增长。
LLM_LOG_MAX_ROWS=2000

# ============================================
# 复杂问题稳定性配置（Sprint 5.2）
# ============================================
# 工具调用轮次上限：超出则截断并提示用户，防止复杂任务做不完。
MAX_TOOL_ROUNDS=8
# SSE 心跳间隔（毫秒）：复杂任务期间周期性发送注释帧保活，防止连接被中间层掐断。
#   ⚠️ 必须显著小于 Bun.serve 的 idleTimeout（见 src/index.ts，已设为 255 秒）。
#   推荐 10000（10 秒）或更小；切勿大于 255000，否则连接会在心跳到达前被关闭。
SSE_HEARTBEAT_MS=10000

# ============================================
# 平台兜底配置（需求域 T / T-06）
# ============================================
# 工具结果总长度上限（字符）：任一工具结果回灌给模型前的「与工具无关」长度兜底，
#   超限则截断并在末尾标注原长与上限（避免单个工具结果打爆上下文）。
#   默认 32000；不进配置页，手工维护；留空或非法值自动回退默认值。
TOOL_RESULT_MAX_CHARS=32000

# ============================================
# 互联网工具配置（需求域 R / P0-d）
# ============================================
# 总开关：联网工具（网页检索/抓取）是否出现在模型可见工具列表。
#   默认开启；保存后热更立即生效，无需重启（R-13）。
INTERNET_ENABLED=true
# 供应商：检索与抓取各自独立选择（本期内置 deepseek）。
#   任一供应商缺密钥只影响其所属 kind，不影响另一 kind（R-07/R-14）。
INTERNET_SEARCH_PROVIDER=deepseek
INTERNET_FETCH_PROVIDER=deepseek
# 供应商密钥：按供应商独立配置，留空 = 免鉴权（请求完全省略鉴权头，R-15）。
#   ⚠️ 不设全局回退（X-06）。需要删除已保存的密钥时，请用配置页该密钥项的
#      「清空」按钮（接口以独立 clear 字段表达），不要用留空表达清空。
INTERNET_DEEPSEEK_API_KEY=
# 基址与端点路径：仅当供应商实际地址与默认值不同时才需要改（手工维护，不进配置页）。
#   ✅ 已按 DeepSeek 官方「网页搜索与抓取」文档核实（2026-10-21）：
#      Search = POST /v1/tools/search，Fetch = POST /v1/tools/fetch。
#   ⚠️ 官方并不存在 /v1/search、/v1/fetch 这两个路由，填旧值会稳定返回 404（表现为 not_extractable）。
INTERNET_DEEPSEEK_BASE_URL=https://api.deepseek.com
INTERNET_DEEPSEEK_SEARCH_PATH=/v1/tools/search
INTERNET_DEEPSEEK_FETCH_PATH=/v1/tools/fetch
# 检索默认条数（工具侧最终仍钳制到 1–10）。
INTERNET_DEFAULT_COUNT=5
# 单次上游请求超时（毫秒）：超时挂在中止信号上，点「停止」同样会中止在途请求（R-39/R-40）。
INTERNET_TIMEOUT_MS=20000
# 抓取回灌上限（字符）：单次抓取正文回灌给模型的字符上限，超限按三要素标注截断（R-24/R-41）。
INTERNET_FETCH_MAX_CHARS=8000
# 续读暂存四要素（R-30）：TTL（秒）、单会话条数、单条字符上限、全局字符上限（默认 4 MB）。
#   暂存只用于同一 URL 的偏移续读，不是计费缓存；不跨会话复用。
INTERNET_STORE_TTL_S=300
INTERNET_STORE_MAX_ITEMS_PER_SESSION=8
INTERNET_STORE_MAX_CHARS_PER_ITEM=200000
INTERNET_STORE_MAX_CHARS_TOTAL=4194304

# ============================================
# 浏览器工具配置（需求域 BR / P0）
# ============================================
# 总开关：open / observe / act / extract / close 五个工具是否出现在模型可见工具列表。
#   ⚠️ 默认关闭。开启后模型可让真实浏览器点击真实按钮（可能产生下单、发帖等真实后果），
#      请在你人在屏幕前时使用。保存后热更立即生效，无需重启。
#   取值 true / false（也接受 1/0、yes/no、on/off，不分大小写）；
#   写成无法识别的值时按「关闭」处理，并在启动日志打一条告警（不会静默）。
BROWSER_ENABLED=false
# 浏览器可执行文件路径：auto = 自动探测（Edge → Chrome，含 32/64 位 Program Files 与用户级目录）。
#   也可填绝对路径覆盖探测。路径不存在时启动失败并列出已尝试路径（不静默回退）。
BROWSER_EXECUTABLE_PATH=auto
# 无头模式：true=不显示窗口（默认）；false=显示窗口，便于观察模型操作，
#   拖拽一类对无头环境敏感的交互也建议用有头模式。
BROWSER_HEADLESS=true
# 窗口置前开关：open 结束（含「打开失败但窗口保留」）后，把浏览器窗口带到最前并解除最小化。默认开启。
#   ⚠️ 关闭后 open 不再做任何窗口激活，且不再以最大化（--start-maximized）启动 ——
#      这是「窗口抢焦点」的唯一回滚旋钮。生效范围：置前行为改完即对下一次 open 生效；
#      --start-maximized 只影响此后**新建**的会话（浏览器已在运行时不会重新加启动参数）。
#   本项不进配置页（与 BROWSER_MAX_SESSIONS 同口径），手工维护；写成无法识别的值时按「开启」处理并告警。
BROWSER_FOREGROUND_ON_OPEN=true
# 调试端口：0 = 每次随机分配（默认）。设为固定值用于端口冲突排查场景；
#   固定端口被占用时直接失败并提示，不会静默换端口。
BROWSER_DEBUG_PORT=0
# 用户数据目录模式：temp=每次新建临时目录、会话关闭即删（默认，不继承日常 cookie）；
#   persist=复用固定目录 —— 等于把登录态交给模型，请谨慎开启。
BROWSER_PROFILE_MODE=temp
# 持久 profile 目录（仅 persist 模式使用）。留空则回退临时模式并告警。
#   请填独立目录（如 data/browser-profile）；切勿指向日常 Edge/Chrome 的用户数据目录。
BROWSER_PROFILE_DIR=
# 会话空闲 TTL（秒）：到期自动结束浏览器进程并删除临时目录。
#   ⚠️ 「活动」只按工具调用计算：你在窗口里自己点、自己滚不算，
#      模型 3 分钟不调用就会被回收 —— 觉得窗口关得太快就把这里调大（如 1800）。
#   有调用正在执行或排队时不会被回收（避免把浏览器从动作中途关掉）。
#   检查粒度 5 秒，可填 10 ~ 86400。
BROWSER_SESSION_TTL_S=180
# 并发会话上限：浏览器进程内存占用高，建议保持小值。
BROWSER_MAX_SESSIONS=2
# 单会话标签数上限（默认 10，可填 1–20）。
#   open 时若会话已存在，会在**新标签**里打开新页面并保留原标签；达到上限后 open 返回 tab_limit，
#   需先 close（scope=tab）关掉当前标签再打开。
#   ⚠️ 设为 1 即退回「单标签语义」：open 复用同一个标签导航、不登记站点自己弹出来的新标签、
#      结果里不输出标签清单 —— 这是标签栈的唯一回滚旋钮。
#   本项不进配置页（与 BROWSER_MAX_SESSIONS 同口径），手工维护；留空或非法值回退默认 10。
BROWSER_MAX_TABS=10
# 单步动作超时（毫秒）：覆盖「定位 + 交互 + 变更等待」整步，超时返回 action_timeout。
BROWSER_ACTION_TIMEOUT_MS=8000
# 导航超时（毫秒）：判据是「加载完成 + 稳定窗口」，不是「导航命令返回」。
BROWSER_NAV_TIMEOUT_MS=20000
# 稳定窗口（毫秒）：这段时间内无 DOM 变更才算加载稳定。
BROWSER_STABLE_WINDOW_MS=400
# 快照元素上限与正文字符上限（单次结果另有 24000 字符硬预算）。
BROWSER_SNAPSHOT_MAX_ELEMENTS=120
BROWSER_SNAPSHOT_MAX_CHARS=6000
# extract（只读取局部内容）的两个上限，**语义独立于上面的快照上限**：
#   快照是「整页概览」，extract 是「局部细读」；共用一个键会让调大取文时把快照一起撑爆。
#   单次回灌上限：默认 12000，可填 500–24000（另有 24000 字符硬预算，超出会显式标注截断）。
#   命中清单条数：默认 20，可填 1–200（超出只给清单前若干条，正文仍用 index 单取）。
#   两者都不进配置页（与 BROWSER_MAX_SESSIONS 同口径），手工维护；留空或非法值回退默认。
BROWSER_EXTRACT_MAX_CHARS=12000
BROWSER_EXTRACT_MAX_ELEMENTS=20
# 单次 act 的动作数上限（模型侧建议 ≤5）。
BROWSER_MAX_ACTIONS=10
# 域名白名单（逗号分隔主机后缀，example.com 匹配自身与子域）。
#   为空 = 不额外限制，但仍受私有网段阻断约束。
BROWSER_DOMAIN_ALLOWLIST=
# 域名黑名单（优先级高于白名单）。
BROWSER_DOMAIN_BLOCKLIST=
# 私有网段阻断：在浏览器内部对每个请求判定目标地址（回环/私有/链路本地）。
#   ⚠️ 关闭后只校验入参 URL，页面内跳转与子资源请求不再受限，存在内网探测风险。
BROWSER_BLOCK_PRIVATE_NET=true
# 允许下载 / 允许上传（文件选择）：默认拒绝，不落盘、不读本机文件。
#   开启后模型可让页面把文件写到本机 / 读取本机文件，请自行评估风险。
BROWSER_ALLOW_DOWNLOAD=false
BROWSER_ALLOW_UPLOAD=false
# 拖拽插值步数：默认 12，代码侧强制下限 10（步数过小会被拖拽库判定为点击）。
BROWSER_DRAG_STEPS=12
# 逐字输入（fill mode=type）的字符间隔毫秒，上限 100；0 表示尽快输入。
BROWSER_TYPE_DELAY_MS=0

# ============================================
# 本机命令执行配置（批次三 / SH-46 ~ SH-49）
# ============================================
#  ⚠️ 风险总声明（必读，SH-31 / SH-32 / SH-39 / SH-40）：
#    · 命令以**服务进程权限**在本机真实执行，会改动文件与系统状态，无法撤销。
#    · **没有沙箱**：cwd 守卫只约束「启动目录」，命令内部可用 cd .. 或绝对路径访问任意位置；
#      也不做容器 / 作业对象 / 低权限令牌隔离。审批是**主要**风险控制手段，其余都是缓解。
#    · 命令可发起**任意网络请求**，不经过任何域名或私有网段策略（联网工具的域名策略不作用于命令）。
#    · 命令产生的文件可以落在总操作目录之外，工具无法阻止。
#    · 拒绝清单 / 允许清单都是**启发式**：可通过变量展开、字符串拼接、别名、脚本文件、
#      大小写与转义变体绕过，不得当作安全保证。
#    · 提示音（approval_pending）只是**附加**通道，不替代审批弹窗，也不构成审批入口。
#
# 权限档位：三值枚举（AP-01 ~ AP-05）。
#    forbid = 禁止（默认）：run 工具不在模型可见列表；被硬调返回 tool_disabled，不弹窗、不创建进程。
#    ask    = 需用户同意：每次执行都弹窗等用户点确认，用户不在屏幕前就什么也执行不了。
#    allow  = 允许：不弹窗直接执行 —— **等于把本机命令行完全交给模型，不再有任何人工闸门**。
#  保存 .env 后热更立即生效；切换档位**不影响**已存在的授权记忆（AP-05）。
SHELL_PERMISSION=forbid
# 审批等待上限（毫秒，默认 120000）：弹窗超过该时长无人应答 → approval_timeout，命令不执行。
#   只约束「等人」的时间，不延长单条命令的执行超时（AP-16）。进配置页。
SHELL_APPROVAL_WAIT_MS=120000
# 本会话授权记忆（默认开）：用户选「本会话都允许」的命令在本会话内不再弹窗；关闭则退化为逐次询问。
#   记忆只在服务端内存：不落盘、不写会话历史、不进模型上下文、不经任何工具返回给模型；
#   会话结束、服务重启、界面断连即清空（AP-13 / XS-13）。进配置页。
SHELL_SESSION_MEMORY_ENABLED=true
# 是否提供「本会话都允许 · 所有命令」选项（默认提供）。关闭后只保留单条命令级的记忆选项（AP-15）。
#   该选项等于在本会话内关闭审批，界面会给出最高级别警示。本项不进配置页（手工维护）。
SHELL_ALLOW_ALL_OPTION=true
# 拒绝冷却时长（毫秒，默认 60000）：同一条命令被拒绝后，冷却期内原样重发**不再弹窗**，
#   直接返回 denied_by_user 并提示「改变命令或调整档位」。timeout / cancelled / unavailable 不进冷却（AP-17）。
#   本项不进配置页。
SHELL_DENY_COOLDOWN_MS=60000
# shell 类型：cmd / powershell（模型不能选择，只能由这里决定，SH-12 / XS-04）。
#   powershell 以 -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass 启动，不加载用户配置。
#   引号、编码、权限语义随 shell 变化，切换前请确认命令写法。进配置页。
SHELL_TYPE=cmd
# 默认超时（毫秒，默认 30000）：模型未传 timeoutMs 时使用。进配置页。
SHELL_TIMEOUT_DEFAULT_MS=30000
# 超时上限（毫秒，默认 120000）：模型传入的 timeoutMs 会被钳制到 [1000, 本值]。
#   超时**必须终止整个进程树**（cmd /c 派生的孙进程一并终止）。本项不进配置页。
SHELL_TIMEOUT_MAX_MS=120000
# 输出回灌上限（字符，默认 8000）：单次执行的**结果总长**上限（含命令原文、退出码、头尾标注与约束尾行），
#   不是输出片段上限；须显著小于平台兜底 TOOL_RESULT_MAX_CHARS（默认 32000）。
#   超限按三要素标注：已显示区间、原始字节数、后续获取方式（重定向到文件后用读文件工具读取）。
#   进配置页（500–24000）。
SHELL_OUTPUT_MAX_CHARS=8000
# 命令长度上限（字符，默认 4000）：超限本地拒绝（不创建进程、不弹窗），提示拆分为多次调用或改写为脚本文件。
#   本项不进配置页。
SHELL_MAX_COMMAND_CHARS=4000
# 全局执行并发上限（默认 1）：同一会话本就串行；本项是跨会话的全局上限。
#   槽位在**用户批准后、创建进程前**才获取（挂起审批不占槽位）；超限立即 busy，不排队（SH-17 / AP-08）。
#   本项不进配置页。
SHELL_MAX_CONCURRENCY=1
# UTF-8 统一编码（默认开）：先按 UTF-8 严格解码；失败则按控制台代码页（如 GBK）解码，
#   并在回灌正文里显式告知「输出编码可能不匹配」，不静默回灌乱码（SH-28）。
#   说明：为满足 AP-19「弹窗展示与执行同源」，本实现**不改写命令**（不拼 chcp 前缀），
#   编码统一发生在解码侧；详见 docs/BATCH3-本机命令执行与授权提示音-代码修改说明.md §3.4。进配置页。
SHELL_UTF8_UNIFY=true
# 拒绝清单（逗号分隔，默认内置 19 条）：命中即 denied_by_policy，不创建进程、不弹窗。
#   匹配方式：大小写不敏感、去除多余空白后按「包含」匹配整条命令文本。
#   ⚠️ 启发式，可绕过（见文件头的风险总声明）。进配置页。
SHELL_DENY_LIST=format,diskpart,bcdedit,vssadmin delete,vssadmin resize,cipher /w,wbadmin delete,reg delete,reg add,shutdown,restart-computer,stop-computer,net user,net localgroup,takeown /f,icacls . /reset,del /f /s /q c:,rd /s /q c:,rmdir /s /q c:
# 允许清单（逗号分隔，默认 none = 未启用）：非空时**只放行首 token 命中**的命令，且优先于拒绝清单判定。
#   允许清单**不能替代审批**：命中清单仍会弹窗（除非档位为允许或授权记忆命中）。进配置页。
#   ⚠️ 非密文文本项不接受空值，因此用固定取值 none 表达「未启用」（SH-47 ③）。
SHELL_ALLOW_LIST=none
# 追加环境变量键（逗号分隔，默认空）：子进程环境**不整体继承**服务进程环境，只放行
#   SystemRoot / PATH / TEMP / USERPROFILE 等必需键 + 这里追加的键；
#   凡键名含 KEY / TOKEN / SECRET / PASSWORD / CREDENTIAL 的一律剔除（追加项同样生效），
#   API 密钥永不出现在子进程环境中（SH-35）。本项不进配置页。
SHELL_EXTRA_ENV_KEYS=
