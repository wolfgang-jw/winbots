# ============================================
# 应用配置
# ============================================
APP_PORT=3001

# ============================================
# LLM 配置
# ============================================
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-apikey
LLM_MODEL=deepseek-flash
# 思考字段下发方式（需求域 C）：控制请求体携带哪些思考相关字段。
#   none     = 均不下发（默认；接入非 DeepSeek 的 OpenAI 兼容服务商不会被未知字段拒绝）
#   effort   = 仅下发推理强度
#   thinking = 仅下发思考开关
#   both     = 两者都下发
#   是否下发只看这一项；下面两项只提供「取值」，不再各自决定请求体是否携带字段。
LLM_THINKING_MODE=none
# 思考开关字段的取值来源（true=开启，false=关闭）；不下发时该值不进入请求体。
LLM_THINKING=true
# 推理强度字段的取值来源（low / high / max）；不下发时该值不进入请求体。
LLM_REASONING_EFFORT=high

# ============================================
# LLM 对话日志配置（Sprint 5.1 / US-LOG-1）
# ============================================
# 日志总开关：true=记录与 LLM 的对话日志（供问题分析），false/留空=关闭。
#   默认关闭，避免日常使用产生额外 IO 与磁盘占用。
LLM_LOG_ENABLED=false
# 日志文件路径（JSONL，每行一条 JSON；内容不截断）。
LLM_LOG_FILE=data/llm_logs.jsonl
# 日志条数上限：超出后自动清理最旧记录，防止无限增长。
LLM_LOG_MAX_ROWS=2000

# ============================================
# 复杂问题稳定性配置（Sprint 5.2）
# ============================================
# 工具调用轮次上限：超出则截断并提示用户，防止复杂任务做不完。
MAX_TOOL_ROUNDS=8
# SSE 心跳间隔（毫秒）：复杂任务期间周期性发送注释帧保活，防止连接被中间层掐断。
#   ⚠️ 必须显著小于 Bun.serve 的 idleTimeout（见 src/index.ts，已设为 255 秒）。
#   推荐 10000（10 秒）或更小；切勿大于 255000，否则连接会在心跳到达前被关闭。
SSE_HEARTBEAT_MS=10000

# ============================================
# 平台兜底配置（需求域 T / T-06）
# ============================================
# 工具结果总长度上限（字符）：任一工具结果回灌给模型前的「与工具无关」长度兜底，
#   超限则截断并在末尾标注原长与上限（避免单个工具结果打爆上下文）。
#   默认 32000；不进配置页，手工维护；留空或非法值自动回退默认值。
TOOL_RESULT_MAX_CHARS=32000

# ============================================
# 工具配置（文件 / 命令执行 / 互联网 / 浏览器）—— 已全部下沉，不在本文件列默认值
# ============================================
# ⚠️ 本模板**不再包含**任何工具域配置项（原 FILE_* / INTERNET_* / BROWSER_* / SHELL_* 已删除或下沉）。
#    工具配置的来源只有一个：`etc/tools/**` 里各目录 `_settings.ts` 与出口文件 `export const settings`。
#
# 【怎么改】推荐用配置页：http://localhost:3001/?view=config › 工具配置
#    也可以直接在本文件手写下面四类「托管键」（键名区分大小写，前缀必须一致）：
#
#    TOOLON__<目录>                    目录开关      例：TOOLON__local=true
#    TOOLON__<目录>__<文件>            工具组开关    例：TOOLON__local__fileRead=true
#    TOOLSET__<目录>__<文件>__<键>     组设置项      例：TOOLSET__local__shell__permission=ask
#    etc__tools__<目录>__<键>          目录设置项    例：etc__tools__local__file_root_dir=working
#
#    补充规则：
#    · 目录路径用 `/` 分隔，例如浏览器组是 `TOOLON__internet__browser`；
#    · 键名不得出现连续下划线 `__`（`__` 是层级分隔符），也不要以 `_` 开头；
#    · **值等于默认值时会自动删键**，所以「恢复默认」表现为这一行消失，这是正常现象；
#    · 托管键**不进入进程环境变量**，只由取值层读取 .env 生效（因此不要指望子进程/命令行能看到它们）；
#    · 写错前缀或键名的行不会被认领，会集中显示在配置页底部的「🧹 遗留键」里，可在那里核对并删除；
#    · 本文件被外部工具写成多条同名键时「最后一行生效」，启动日志会就此告警。
#
# 【升级提示（重要）】
#    5 个旧「启用开关」按规范「删除，不迁移」：
#      FILE_READ_ENABLED / FILE_CREATE_ENABLED / FILE_MODIFY_ENABLED / INTERNET_ENABLED / BROWSER_ENABLED
#    ⇒ **升级后所有工具默认全部关闭**，必须到配置页按「目录 → 工具组」重新开启一次所需工具。
#    其余旧键（FILE_ROOT_DIR、SHELL_*、BROWSER_*、INTERNET_* 调优项）在首次启动时自动迁移为
#    对应的 TOOLSET__* / etc__tools__*，旧行同时删除；迁移日志形如：
#      🚚 [migrate] 存量配置已分流：写入 N 个新键、清除 M 个旧行
#
# 【本机命令执行（local/shell）风险声明 —— 开启前必读】
#    · 命令以**服务进程权限**在本机真实执行，会改动文件与系统状态，无法撤销；
#    · **没有沙箱**：cwd 只约束「启动目录」，命令可用 cd .. 或绝对路径访问任意位置；
#    · 命令可发起任意网络请求，不经过联网工具的域名 / 私有网段策略；
#    · 拒绝清单 / 允许清单都是**启发式**，可被变量展开、拼接、脚本文件等绕过，不是安全保证；
#    · 权限档位（TOOLSET__local__shell__permission）三选一：
#        forbid = 禁止（默认，run 工具不在模型可见列表）
#        ask    = 每次执行都要用户点一次确认
#        allow  = 不弹窗直接执行 —— 等于把本机命令行完全交给模型，不再有任何人工闸门
#
# 【常用键示例（默认值，通常不需要写；写出来只是为了让你知道键名）】
# TOOLON__local=true
# TOOLON__local__fileRead=true
# TOOLON__local__fileNew=true
# TOOLON__local__fileModify=true
# TOOLON__local__shell=true
# TOOLON__internet=true
# TOOLON__internet__web=true
# TOOLON__internet__browser=true
# etc__tools__local__file_root_dir=working
# TOOLSET__local__fileRead__default_lines=2000
# TOOLSET__local__shell__permission=forbid
# TOOLSET__local__shell__approval_wait_ms=120000
# TOOLSET__internet__web__deepseek_api_key=
# TOOLSET__internet__browser__headless=true
